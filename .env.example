# Variables de production, lues par Docker Compose.
# Copier ce fichier en .env.production, puis renseigner les valeurs vides.
# .env.production ne doit jamais être versionné (il est exclu par .gitignore).

# PostgreSQL. POSTGRES_PASSWORD est à renseigner.
POSTGRES_USER=neuraxion
POSTGRES_PASSWORD=
POSTGRES_DB=neuraxion
# Hôte et port vus depuis les conteneurs. Depuis votre machine, la base répond sur localhost:5433.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_MODEL_NAME=credit-default
MLFLOW_MODEL_ALIAS=champion

# Clé attendue par POST /train dans l'en-tête X-API-Key. À renseigner.
TRAIN_API_KEY=

# Facultatif : seulement si Kaggle refuse le téléchargement anonyme (README, section Données).
KAGGLE_API_TOKEN=

# Dossier des données locales, relatif à la racine du dépôt et exclu de Git.
DATA_DIR=data
