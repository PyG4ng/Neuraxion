# Variables des notebooks et des essais en local.
# Copier ce fichier en .env.experiment. Il ne doit jamais être versionné.

# MLflow local, lancé à la racine du dépôt avec :
# uv run mlflow server --host 127.0.0.1 --port 5001
# Le port par défaut (5000) est pris par AirPlay sur macOS.
MLFLOW_TRACKING_URI=http://127.0.0.1:5001

# Dossier des données locales, relatif à la racine du dépôt et exclu de Git.
DATA_DIR=data

# Jeton du service jupyter de Compose (profil experiment). Mettre une valeur au hasard.
JUPYTER_TOKEN=
